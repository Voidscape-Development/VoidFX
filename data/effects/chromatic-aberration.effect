// VoidFX - Chromatic Aberration
// Splits the red and blue channels apart (linearly or radially like a lens)
// and optionally layers VHS artifacts on top: scanlines, noise and tracking
// wobble.

uniform float4x4 ViewProj;
uniform texture2d image;

uniform float2 uv_size;
uniform float time;

// 0 = linear, 1 = radial
uniform float radial;
// Channel offset in pixels.
uniform float strength;
// Unit direction for linear mode.
uniform float2 direction;
// Radial mode: center in UV space and falloff exponent.
uniform float2 center;
uniform float falloff;

uniform float scanline_intensity;
uniform float scanline_spacing;
uniform float noise_amount;
uniform float tracking_amount;

sampler_state textureSampler {
	Filter    = Linear;
	AddressU  = Clamp;
	AddressV  = Clamp;
};

struct VertData {
	float4 pos : POSITION;
	float2 uv  : TEXCOORD0;
};

VertData VSDefault(VertData v_in)
{
	VertData vert_out;
	vert_out.pos = mul(float4(v_in.pos.xyz, 1.0), ViewProj);
	vert_out.uv  = v_in.uv;
	return vert_out;
}

float hash12(float2 p)
{
	float3 p3 = frac(float3(p.x, p.y, p.x) * 0.1031);
	p3 += dot(p3, p3.yzx + 33.33);
	return frac((p3.x + p3.y) * p3.z);
}

float2 channel_offset(float2 uv)
{
	float2 px = (uv - center) * uv_size;
	float dist = length(px);
	float half_diag = 0.5 * length(uv_size);
	float2 radial_dir = dist > 0.0001 ? px / dist : float2(0.0, 0.0);
	float radial_scale = pow(saturate(dist / half_diag), falloff);

	float2 offset_px = lerp(direction, radial_dir * radial_scale, radial) * strength;
	return offset_px / uv_size;
}

float tracking_shift(float2 uv)
{
	float row = floor(uv.y * uv_size.y);

	// A distorted band that slowly rolls down the frame.
	float band_pos = frac(time * 0.12);
	float band_dist = abs(uv.y - band_pos);
	band_dist = min(band_dist, 1.0 - band_dist);
	float band = 1.0 - smoothstep(0.0, 0.06, band_dist);

	float jitter = hash12(float2(row, floor(time * 30.0))) - 0.5;
	float wave = sin(uv.y * 40.0 + time * 3.0) * 0.15;

	float shift_px = tracking_amount * (band * jitter * 24.0 + wave * 4.0);
	return shift_px / uv_size.x;
}

float4 PSChromaticAberration(VertData v_in) : TARGET
{
	float2 uv = v_in.uv;
	uv.x += tracking_shift(uv);

	float2 offset = channel_offset(uv);

	float4 r = image.Sample(textureSampler, uv + offset);
	float4 g = image.Sample(textureSampler, uv);
	float4 b = image.Sample(textureSampler, uv - offset);

	float4 color = float4(r.r, g.g, b.b, max(max(r.a, g.a), b.a));

	// Scanlines: darken every other band of `scanline_spacing` pixels.
	float line_phase = uv.y * uv_size.y / max(scanline_spacing, 1.0) * 3.14159265;
	float scan = 0.5 + 0.5 * sin(line_phase);
	color.rgb *= 1.0 - scanline_intensity * scan;

	// Animated grain.
	float grain = hash12(uv * uv_size + frac(time * 7.13) * 1000.0) - 0.5;
	color.rgb += grain * noise_amount * color.a;

	color.rgb = saturate(color.rgb);
	return color;
}

technique Draw
{
	pass
	{
		vertex_shader = VSDefault(v_in);
		pixel_shader  = PSChromaticAberration(v_in);
	}
}
